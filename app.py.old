#!/usr/bin/env python3
from flask import Flask, request, render_template_string
import nmap
import os
from groq import Groq

app = Flask(__name__)
scanner = nmap.PortScanner()
client = Groq(api_key=os.environ.get("GROQ_API_KEY"))

# Liste blanche : seule la cible du laboratoire est autorisée
CIBLES_AUTORISEES = ["192.168.1.42"]

TEMPLATE = """
<!doctype html>
<html><head><title>TP1 - Scan réseau enrichi par IA</title></head>
<body style="font-family: sans-serif; max-width: 900px; margin: 40px auto;">
<h1>Scanner réseau pédagogique (TP1)</h1>
<form method="POST">
  <label>Cible (IP du laboratoire) :</label>
  <input type="text" name="cible" value="192.168.1.42">
  <button type="submit">Scanner</button>
</form>
{% if resultats %}
<h2>Résultats bruts Nmap</h2>
<table border="1" cellpadding="6">
<tr><th>Hôte</th><th>Port</th><th>Protocole</th><th>Service</th><th>Version</th><th>État</th></tr>
{% for r in resultats %}
<tr><td>{{r.hote}}</td><td>{{r.port}}</td><td>{{r.protocole}}</td><td>{{r.service}}</td><td>{{r.version}}</td><td>{{r.etat}}</td></tr>
{% endfor %}
</table>
<h2>Synthèse générée par IA</h2>
<div style="background:#f4f4f4; padding:15px; white-space:pre-wrap;">{{synthese}}</div>
{% endif %}
</body></html>
"""

def enrichir_avec_ia(resultats):
    prompt = (
        "Voici un inventaire de services réseau détectés par Nmap : "
        f"{resultats}. Rédige une synthèse pédagogique en français : "
        "rôle probable de chaque service, risques génériques connus, "
        "et recommandations générales de durcissement. "
        "N'émets aucune instruction d'exploitation."
    )
    reponse = client.chat.completions.create(
        model="openai/gpt-oss-120b",
        messages=[{"role": "user", "content": prompt}],
        max_tokens=1000,
    )
    return reponse.choices[0].message.content

@app.route('/', methods=['GET', 'POST'])
def index():
    resultats, synthese = None, None
    if request.method == 'POST':
        cible = request.form['cible']
        if cible not in CIBLES_AUTORISEES:
            return f"Cible non autorisée. Cibles autorisées : {CIBLES_AUTORISEES}", 403

        scanner.scan(hosts=cible, arguments='-sV -T4')
        resultats = []
        for hote in scanner.all_hosts():
            for proto in scanner[hote].all_protocols():
                for port, info in scanner[hote][proto].items():
                    resultats.append({
                        'hote': hote, 'port': port, 'protocole': proto,
                        'service': info.get('name'),
                        'version': info.get('version') or 'non détectée',
                        'etat': info.get('state'),
                    })
        synthese = enrichir_avec_ia(resultats)

    return render_template_string(TEMPLATE, resultats=resultats, synthese=synthese)

if __name__ == '__main__':
    app.run(debug=False, host='0.0.0.0', port=5000)
